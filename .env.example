# DeepTrace Configuration

# Mode: set to 'true' to run with mock data (no real models needed)
MOCK_MODE=true

# Server ports
ORCHESTRATOR_PORT=3001
AI_SERVICE_PORT=8000
FRONTEND_PORT=5173

# AI Service URL (used by orchestrator)
AI_SERVICE_URL=http://localhost:8000

# Gemini API (for claim extraction and judge)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Fact Check Tools API
FACTCHECK_API_KEY=your_factcheck_api_key_here

# Optional: News API for additional source checking
NEWS_API_KEY=your_news_api_key_here

# Hugging Face (optional, for private models)
HF_TOKEN=your_huggingface_token_here

# Upload settings
MAX_UPLOAD_SIZE_MB=100
TEMP_FILE_TTL_MINUTES=60
